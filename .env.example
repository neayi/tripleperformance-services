# Triple Performance Services Environment Variables
# Copy this file to .env and update with your actual values

# API Configuration
# API_PORT=8000
# API_HOST=0.0.0.0

# Database Configuration (when implementing)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tripleperformance
# DB_USER=your_user
# DB_PASSWORD=your_password

# Translation Service Configuration (when implementing)
# TRANSLATION_API_KEY=your_api_key
# TRANSLATION_SERVICE=google  # or deepl, etc.

# Logging Configuration
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Cron Configuration
# INTERWIKI_CHECK_SCHEDULE="0 2 * * 0"  # Weekly on Sunday at 2 AM

# Triple Performance Configuration
# TP_API_URL=https://api.tripleperformance.fr
# TP_API_KEY=your_api_key

# MediaWiki API Configuration
MEDIAWIKI_USERNAME=your_bot_username
MEDIAWIKI_PASSWORD=your_bot_password
